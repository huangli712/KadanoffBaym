\newcommand{\GgtR}{\tilde{G}^{\mathrm{R}}}
\newcommand{\Sig}{\Sigma}
\newcommand{\Sigret}{\Sigma^{\mathrm{R}}}
\newcommand{\Sigadv}{\Sigma^{\mathrm{A}}}
